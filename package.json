{
  "name": "genai-browser-tool",
  "version": "5.1.0",
  "description": "Chrome extension that summarizes, questions, translates, and analyses the current page using an AI provider and API key you supply.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,json,css,html,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "browser-extension",
    "summarization",
    "question-answering",
    "translation",
    "productivity",
    "openai",
    "claude",
    "gemini"
  ],
  "author": "Aaron Sequeira <aaronsequeira12@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaron-seq/GenAI-Browser-Tool.git"
  },
  "bugs": {
    "url": "https://github.com/aaron-seq/GenAI-Browser-Tool/issues"
  },
  "homepage": "https://github.com/aaron-seq/GenAI-Browser-Tool#readme",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "comments": {
    "dependencies": "The extension ships zero runtime dependencies: fetch, chrome.* APIs, and the DOM only. It also has no build step \u2014 the repository root is the loadable extension, so packaging is a zip of the root."
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "Chrome >= 88",
    "Firefox >= 78",
    "Edge >= 88"
  ],
  "files": [
    "*.js",
    "*.html",
    "*.css",
    "assets/**/*",
    "core/**/*",
    "providers/**/*",
    "scripts/**/*",
    "services/**/*",
    "styles/**/*",
    "utils/**/*",
    "manifest.json",
    "README.md",
    "LICENSE"
  ]
}
